{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linkamp",
  "version": "0.1.0",
  "identifier": "dev.linkamp.app",
  "build": {
    "beforeDevCommand": "corepack npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linkamp",
        "width": 1100,
        "height": 720,
        "minWidth": 780,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
